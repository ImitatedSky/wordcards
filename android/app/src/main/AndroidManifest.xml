<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      唯一的權限是 INTERNET，只用來在第一次用到時下載中文字型（沒打包進 APK，見
      MainActivity）。沒有網路時改用系統字，其餘功能完全離線。不讀檔案、不碰通訊錄
      或位置：匯入單字用的檔案選擇器走系統的 ACTION_GET_CONTENT，拿到的是使用者
      當下挑的那一個檔，不需要儲存權限。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoutinaWords">

        <!--
          家族標記：讓 Routina（Hub）掃得到、列進目錄、並能檢查更新。
          鍵名的定義見 routina repo 的 core/contract/Family.kt。
        -->
        <meta-data
            android:name="com.routina.family.member"
            android:value="true" />
        <meta-data
            android:name="com.routina.family.id"
            android:value="words" />
        <meta-data
            android:name="com.routina.family.name"
            android:value="Routina Words" />
        <meta-data
            android:name="com.routina.family.summary"
            android:value="英文單字卡" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
