    <!-- 小工具配色，取自網頁的淺色主題（slate / blue），深色版在 values-night -->
    <color name="widget_background">#FFFFFF</color>
    <color name="widget_text">#0F172A</color>
    <color name="widget_muted">#62748E</color>
    <color name="widget_accent">#155DFC</color>
